{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Skills Index Schema",
  "description": "Comprehensive schema for faceted skill inventory with training paths",
  "version": "2.3.0",
  "definitions": {
    "facet_type": {
      "type": "string",
      "enum": [
        "hands_on_language",
        "hands_on_framework",
        "hands_on_tool",
        "hands_on_platform",
        "strategic_domain",
        "leadership_soft_skill"
      ],
      "description": "Category of skill expertise"
    },
    "experience_level": {
      "type": "string",
      "enum": ["beginner", "intermediate", "advanced", "expert"],
      "description": "Subjective assessment of proficiency depth"
    },
    "proficiency": {
      "type": "string",
      "enum": ["novice", "beginner", "intermediate", "advanced", "expert"],
      "description": "Current demonstrated competency level"
    },
    "confidence_level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "description": "Self-assessed confidence in skill capability (1=uncertain, 10=completely confident)"
    },
    "training_type": {
      "type": "string",
      "enum": [
        "self-taught",
        "formal-education",
        "on-the-job",
        "workshop",
        "course",
        "certification",
        "mentorship"
      ],
      "description": "Method of acquiring the skill"
    },
    "venue_id": {
      "type": "string",
      "pattern": "^venue\\.[a-z_]+$",
      "description": "Reference to venue_catalog entry"
    },
    "skill_id": {
      "type": "string",
      "pattern": "^skill\\.[a-z_]+\\.[0-9]+$",
      "description": "Unique identifier for skill in skills_catalog"
    },
    "facet_id": {
      "type": "string",
      "pattern": "^facet\\.[a-z_]+(\\.[0-9]+)?$",
      "description": "Unique identifier for facet in facet_catalog"
    },
    "training_id": {
      "type": "string",
      "pattern": "^training\\.[a-z_]+\\.[0-9_]+$",
      "description": "Unique identifier for training entry"
    },
    "skill_training_entry": {
      "type": "object",
      "required": ["training_id", "type", "start_year"],
      "properties": {
        "training_id": {
          "$ref": "#/definitions/training_id"
        },
        "type": {
          "$ref": "#/definitions/training_type"
        },
        "venue_id": {
          "$ref": "#/definitions/venue_id"
        },
        "start_year": {
          "type": "integer",
          "minimum": 1990,
          "maximum": 2100
        },
        "end_year": {
          "type": "integer",
          "minimum": 1990,
          "maximum": 2100
        },
        "note": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "facet_entry": {
      "type": "object",
      "required": [
        "facet_type",
        "facet_name",
        "years_of_experience",
        "experience_level",
        "proficiency",
        "confidence_level"
      ],
      "properties": {
        "facet_type": {
          "$ref": "#/definitions/facet_type"
        },
        "facet_id": {
          "$ref": "#/definitions/facet_id"
        },
        "facet_name": {
          "type": "string",
          "maxLength": 100
        },
        "years_of_experience": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        },
        "experience_level": {
          "$ref": "#/definitions/experience_level"
        },
        "proficiency": {
          "$ref": "#/definitions/proficiency"
        },
        "confidence_level": {
          "$ref": "#/definitions/confidence_level"
        },
        "last_used": {
          "type": "string",
          "pattern": "^[0-9]{4}-Q[1-4]$",
          "description": "Most recent quarter used (YYYY-QN format)"
        },
        "skill_training": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/skill_training_entry"
          },
          "description": "Training path specific to this facet"
        }
      }
    },
    "skill_group": {
      "type": "object",
      "required": ["skill_name", "description", "years_of_experience", "facets"],
      "properties": {
        "skill_name": {
          "type": "string",
          "maxLength": 150
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "years_of_experience": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        },
        "facets": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/facet_entry"
          },
          "description": "Collection of facets, keyed by facet_id"
        }
      }
    },
    "venue_entry": {
      "type": "object",
      "required": ["venue_id", "name", "role", "start_year", "end_year"],
      "properties": {
        "venue_id": {
          "$ref": "#/definitions/venue_id"
        },
        "name": {
          "type": "string",
          "maxLength": 150
        },
        "role": {
          "type": "string",
          "maxLength": 200
        },
        "start_year": {
          "type": "integer",
          "minimum": 1990,
          "maximum": 2100
        },
        "end_year": {
          "type": "integer",
          "minimum": 1990,
          "maximum": 2100
        },
        "location": {
          "type": "string",
          "maxLength": 200
        }
      }
    }
  }
}
